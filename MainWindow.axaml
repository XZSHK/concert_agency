<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="550"
        x:Class="Avalon.MainWindow"
        Title="Агентство «Апр-Престиж» - Вход"
        WindowStartupLocation="CenterScreen"
        Width="450" Height="550"
        CanResize="False"
        Background="#121212"> <!-- Тёмный фон -->
    
    <Grid>
        <Border Background="#1E1E2F" CornerRadius="20" Margin="30" BoxShadow="0 15 30 0 #80000000" BorderBrush="#333355" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" Spacing="25" Margin="40">
                
                <StackPanel Spacing="5">
                    <TextBlock Text="АПР-ПРЕСТИЖ" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Foreground="#FFD700" LetterSpacing="2"/>
                    <TextBlock Text="Вход в личный кабинет" FontSize="14" HorizontalAlignment="Center" Foreground="#8A8A9E"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Логин / Email" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtLogin" PlaceholderText="Введите ваш логин" Height="45" CornerRadius="8" Background="#2A2A4A" Foreground="White" BorderBrush="#333355" FontSize="14"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Пароль" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtPassword" PlaceholderText="Введите ваш пароль" PasswordChar="●" Height="45" CornerRadius="8" Background="#2A2A4A" Foreground="White" BorderBrush="#333355" FontSize="14"/>
                </StackPanel>

                <Button x:Name="BtnLogin" Content="Войти" HorizontalAlignment="Stretch" Height="45" 
                        Background="#FFD700" Foreground="#121212" FontSize="16" FontWeight="Bold" 
                        CornerRadius="8" Click="BtnLogin_Click" Margin="0,10,0,0"/>
                        
                <Button x:Name="BtnGoToRegister" Content="Еще нет аккаунта? Зарегистрироваться" 
                        HorizontalAlignment="Stretch" Background="Transparent" Foreground="#00FF88" 
                        FontSize="13" Click="BtnGoToRegister_Click"/>
                
                <TextBlock x:Name="TxtError" Text="" Foreground="#FF5555" 
                           HorizontalAlignment="Center" IsVisible="False" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/>
                
            </StackPanel>
        </Border>
    </Grid>
</Window>