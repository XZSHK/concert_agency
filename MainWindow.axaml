<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="470" d:DesignHeight="620"
        x:Class="Avalon.MainWindow"
        Title="Агентство «Арт-Престиж» — Вход"
        WindowStartupLocation="CenterScreen"
        Width="470" Height="620"
        CanResize="False"
        Background="#0F0F18"
        FontFamily="Inter, Segoe UI, Arial">

    <Window.Resources>
        <RadialGradientBrush x:Key="LobbyGlow" Center="50%,15%" RadiusX="90%" RadiusY="90%">
            <GradientStop Offset="0" Color="#332900" />
            <GradientStop Offset="0.45" Color="#181828" />
            <GradientStop Offset="1" Color="#0F0F18" />
        </RadialGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#FFD700" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Фоновое свечение -->
        <Border Background="{StaticResource LobbyGlow}" IsHitTestVisible="False"/>

        <Border CornerRadius="22" Margin="34" Padding="40,34" VerticalAlignment="Center"
                Background="#17172A" BorderBrush="#2E2E46" BorderThickness="1"
                BoxShadow="0 24 60 0 #66000000">
            <StackPanel Spacing="18">

                <!-- Логотип -->
                <StackPanel Spacing="6" Margin="0,0,0,6">
                    <Border Width="64" Height="64" CornerRadius="18" Background="#FFD700"
                            HorizontalAlignment="Center" BoxShadow="0 6 18 0 #44000000">
                        <TextBlock Text="AP" FontSize="30" FontWeight="Black" Foreground="#121212"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="АРТ-ПРЕСТИЖ" FontSize="24" FontWeight="Black"
                               HorizontalAlignment="Center" Foreground="#FFD700"
                               LetterSpacing="4" Margin="0,6,0,0"/>
                    <TextBlock Text="Вход в личный кабинет" FontSize="13"
                               HorizontalAlignment="Center" Foreground="#8F8FA6"/>
                </StackPanel>

                <!-- Логин -->
                <StackPanel Spacing="6">
                    <TextBlock Text="ЛОГИН / EMAIL" FontSize="11" FontWeight="Bold"
                               Foreground="#8F8FA6" LetterSpacing="1"/>
                    <TextBox x:Name="TxtLogin" PlaceholderText="Введите логин или email"
                             Height="46" CornerRadius="10" Background="#22223A"
                             Foreground="White" BorderBrush="#2E2E46" FontSize="14"
                             Padding="12,11"/>
                </StackPanel>

                <!-- Пароль -->
                <StackPanel Spacing="6">
                    <TextBlock Text="ПАРОЛЬ" FontSize="11" FontWeight="Bold"
                               Foreground="#8F8FA6" LetterSpacing="1"/>
                    <TextBox x:Name="TxtPassword" PlaceholderText="Введите пароль"
                             PasswordChar="●" Height="46" CornerRadius="10"
                             Background="#22223A" Foreground="White" BorderBrush="#2E2E46"
                             FontSize="14" Padding="12,11" KeyDown="TxtPassword_KeyDown"/>
                </StackPanel>

                <!-- Кнопки -->
                <Button x:Name="BtnLogin" Classes="darkyellow" Content="ВОЙТИ"
                        HorizontalAlignment="Stretch" Height="48" Margin="0,8,0,0"
                        Background="#E6BE00" Foreground="#121212" FontSize="15" FontWeight="Bold"
                        CornerRadius="10" Click="BtnLogin_Click"/>

                <Button x:Name="BtnGoToRegister" Classes="link" Content="Нет аккаунта? Зарегистрируйтесь"
                        HorizontalAlignment="Stretch" Background="Transparent"
                        Foreground="#E6BE00" FontSize="13" Padding="6,8"
                        Click="BtnGoToRegister_Click"/>

                <TextBlock x:Name="TxtError" Text="" Foreground="#FF5A5A"
                           HorizontalAlignment="Center" IsVisible="False"
                           FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
