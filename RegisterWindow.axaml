<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="800"
        x:Class="Avalon.RegisterWindow"
        Title="Регистрация — Арт-Престиж"
        WindowStartupLocation="CenterScreen"
        Width="620" Height="800"
        CanResize="True"
        Background="#0F0F18"
        FontFamily="Inter, Segoe UI, Arial">

    <Window.Resources>
        <RadialGradientBrush x:Key="RegisterGlow" Center="50%,15%" RadiusX="90%" RadiusY="90%">
            <GradientStop Offset="0" Color="#332900" />
            <GradientStop Offset="0.45" Color="#181828" />
            <GradientStop Offset="1" Color="#0F0F18" />
        </RadialGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#FFD700" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border Background="{StaticResource RegisterGlow}" IsHitTestVisible="False"/>

        <Border CornerRadius="22" Margin="28" Padding="36" VerticalAlignment="Center"
                Background="#17172A" BorderBrush="#2E2E46" BorderThickness="1"
                BoxShadow="0 24 60 0 #66000000">
            <ScrollViewer Padding="0">
                <StackPanel VerticalAlignment="Center" Spacing="14">

                    <StackPanel Spacing="6" Margin="0,0,0,8">
                        <TextBlock Text="НОВЫЙ АККАУНТ" FontSize="22" FontWeight="Black"
                                   HorizontalAlignment="Center" Foreground="#FFD700" LetterSpacing="3"/>
                        <TextBlock Text="Регистрация покупателя билетов «Арт-Престиж»"
                                   FontSize="13" HorizontalAlignment="Center" Foreground="#8F8FA6"/>
                    </StackPanel>

                    <!-- ФИО -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ФИО" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                        <TextBox x:Name="TxtFullName" PlaceholderText="Иванов Иван Иванович"
                                 Height="44" CornerRadius="10" Background="#22223A"
                                 Foreground="White" BorderBrush="#2E2E46" FontSize="14"
                                 Padding="12,11" TextChanged="TxtFullName_TextChanged"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="EMAIL" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                        <TextBox x:Name="TxtEmail" PlaceholderText="example@mail.ru"
                                 Height="44" CornerRadius="10" Background="#22223A"
                                 Foreground="White" BorderBrush="#2E2E46" FontSize="14" Padding="12,11"/>
                    </StackPanel>

                    <!-- Телефон (маска +7 (___) ___-__-__) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ТЕЛЕФОН" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                        <TextBox x:Name="TxtPhone" PlaceholderText="+7 (999) 123-45-67" MaxLength="18"
                                 Height="44" CornerRadius="10" Background="#22223A"
                                 Foreground="White" BorderBrush="#2E2E46" FontSize="14"
                                 Padding="12,11" TextChanged="TxtPhone_TextChanged"/>
                    </StackPanel>

                    <!-- Пароль -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ПАРОЛЬ" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                        <TextBox x:Name="TxtPassword" PlaceholderText="Минимум 6 символов" PasswordChar="●"
                                 Height="44" CornerRadius="10" Background="#22223A"
                                 Foreground="White" BorderBrush="#2E2E46" FontSize="14" Padding="12,11"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkPromo" Content="Получать промокоды и скидки"
                              FontSize="14" Foreground="#E6E6F0" Margin="0,6"/>

                    <Button x:Name="BtnRegister" Classes="darkyellow" Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                            HorizontalAlignment="Stretch" Height="48" Margin="0,6,0,0"
                            Background="#E6BE00" Foreground="#121212" FontSize="15" FontWeight="Bold"
                            CornerRadius="10" Click="BtnRegister_Click"/>

                    <Button x:Name="BtnBack" Classes="link" Content="Уже есть аккаунт? Войти"
                            HorizontalAlignment="Stretch" Background="Transparent"
                            Foreground="#E6BE00" FontSize="13" Padding="6,6" Click="BtnBack_Click"/>

                    <TextBlock x:Name="TxtMessage" Text="" Foreground="#FF5A5A"
                               HorizontalAlignment="Center" IsVisible="False"
                               FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
