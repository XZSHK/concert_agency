<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="750"
        x:Class="Avalon.RegisterWindow"
        Title="Регистрация - Апр-Престиж"
        WindowStartupLocation="CenterScreen"
        Width="600" Height="750"
        CanResize="True"
        Background="#121212"> <!-- Тёмный фон -->
    
    <Grid>
        <Border Background="#1E1E2F" CornerRadius="20" Margin="30" BoxShadow="0 15 30 0 #80000000" BorderBrush="#333355" BorderThickness="1">
            <ScrollViewer>
                <StackPanel VerticalAlignment="Center" Spacing="15" Margin="50">
                    
                    <StackPanel Spacing="5" Margin="0,0,0,20">
                        <TextBlock Text="Создать аккаунт" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFD700"/>
                        <TextBlock Text="Присоединяйтесь к агентству «Апр-Престиж»" FontSize="14" HorizontalAlignment="Center" Foreground="#8A8A9E"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="ФИО" Foreground="#AAAAAA" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtFullName" PlaceholderText="Иванов Иван Иванович" Height="45" CornerRadius="8" Background="#2A2A4A" Foreground="White" BorderBrush="#333355" FontSize="14" TextChanged="TxtFullName_TextChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Email" Foreground="#AAAAAA" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtEmail" PlaceholderText="example@mail.ru" Height="45" CornerRadius="8" Background="#2A2A4A" Foreground="White" BorderBrush="#333355" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Телефон" Foreground="#AAAAAA" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtPhone" PlaceholderText="+7 (999) 123-45-67" Height="45" CornerRadius="8" Background="#2A2A4A" Foreground="White" BorderBrush="#333355" FontSize="14" TextChanged="TxtPhone_TextChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Пароль" Foreground="#AAAAAA" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtPassword" PlaceholderText="Минимум 6 символов" PasswordChar="●" Height="45" CornerRadius="8" Background="#2A2A4A" Foreground="White" BorderBrush="#333355" FontSize="14"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkPromo" Content="Получать промокоды и скидки" FontSize="14" Foreground="#E0E0E0" Margin="0,10,0,10"/>

                    <Button x:Name="BtnRegister" Content="Зарегистрироваться" HorizontalAlignment="Stretch" Height="50" 
                            Background="#FFD700" Foreground="#121212" FontSize="16" FontWeight="Bold" 
                            CornerRadius="8" Click="BtnRegister_Click" Margin="0,10,0,0"/>

                    <Button x:Name="BtnBack" Content="Уже есть аккаунт? Войти" HorizontalAlignment="Stretch" Height="40" 
                            Background="Transparent" Foreground="#00FF88" FontSize="14" Click="BtnBack_Click"/>

                    <TextBlock x:Name="TxtMessage" Text="" Foreground="#FF5555" 
                               HorizontalAlignment="Center" IsVisible="False" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/>
                
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>