<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Avalon"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Avalon.DashboardWindow"
        x:DataType="local:DashboardWindow"
        Title="Арт-Престиж — Личный кабинет"
        WindowStartupLocation="CenterScreen" Width="1200" Height="800"
        WindowState="Maximized"
        Background="#0F0F18"
        FontFamily="Inter, Segoe UI, Arial">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9C9D9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22223A" />
        </Style>
        <Style Selector="Button.buy:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFE255" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#FFD700" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="280, *">

        <!-- ══════════ Боковая панель ══════════ -->
        <Border Background="#15152A" Padding="22,26" BorderBrush="#22223A" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Бренд -->
                <StackPanel Spacing="2">
                    <TextBlock Text="АРТ-ПРЕСТИЖ" FontSize="23" FontWeight="Black"
                               Foreground="#FFD700" LetterSpacing="3"/>
                    <TextBlock Text="Концертно-гастрольное агентство" FontSize="11" Foreground="#7A7A93"/>
                </StackPanel>

                <!-- Навигация -->
                <StackPanel Grid.Row="1" Spacing="6" Margin="0,38,0,0">
                    <Button Classes="nav" Content="🎵  Афиша" Click="ShowEvents_Click"/>
                    <Button Classes="nav" Content="🎟  Мои билеты" Click="ShowMyTickets_Click"/>
                    <Button Classes="nav" Content="👤  Профиль" Click="ShowProfile_Click"/>
                </StackPanel>

                <!-- Пользователь + выход -->
                <StackPanel Grid.Row="2" Spacing="12">
                    <Separator Background="#22223A"/>
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Width="46" Height="46" CornerRadius="23" Background="#FFD700">
                            <TextBlock x:Name="TxtAvatarInitials" Text="Я" FontSize="17" FontWeight="Black"
                                       Foreground="#121212" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtUserName" Grid.Column="1" Text="Пользователь"
                                   Foreground="#E6E6F0" FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <Button x:Name="BtnLogout" Classes="outline" Content="Выйти из аккаунта"
                            HorizontalAlignment="Stretch" Background="Transparent"
                            BorderBrush="#3A3A55" BorderThickness="1" Foreground="#FF6B6B"
                            Padding="14,11" CornerRadius="10" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ Контент ══════════ -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">

            <!-- Верхняя полоса -->
            <Border Background="#15152A" Padding="32,16" BorderBrush="#22223A" BorderThickness="0,0,0,1">
                <TextBlock x:Name="TxtHeader" Text="Ближайшие концерты" FontSize="23" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </Border>

            <!-- ──────── ПАНЕЛЬ 1: Афиша (карточки концертов, картинки из img/) ──────── -->
            <Grid x:Name="PanelEvents" Grid.Row="1" RowDefinitions="Auto, *" Margin="28,20">
                <Grid ColumnDefinitions="*, Auto" Margin="4,0,4,14">
                    <TextBlock x:Name="TxtEventsMessage" Text="" Foreground="#FF6B6B"
                               VerticalAlignment="Center" IsVisible="False" FontSize="13" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Classes="dark" Content="Обновить" Background="#22223A" Foreground="#C9C9D9"
                            Padding="16,9" CornerRadius="8" Click="BtnRefreshEvents_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ConcertEvent">
                                <Border Background="#17172A" CornerRadius="18" Margin="4,0,4,20"
                                        BorderBrush="#2E2E46" BorderThickness="1" ClipToBounds="True"
                                        BoxShadow="0 10 28 0 #55000000" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="240, *">

                                        <!-- Картинка из img/ (вписана целиком — отдаление) -->
                                        <Border Background="#22223A" ClipToBounds="True">
                                            <Image Source="{Binding ImageSource}" Stretch="Uniform" Margin="6"/>
                                        </Border>

                                        <!-- Информация -->
                                        <Grid Grid.Column="1" Margin="26,20" RowDefinitions="Auto, Auto, *, Auto">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="{Binding ArtistName}" FontSize="24" FontWeight="Bold"
                                                           Foreground="White" TextWrapping="Wrap"/>
                                                <Border Grid.Column="1" Background="#FF6B6B" CornerRadius="6"
                                                        Padding="10,4" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding AgeRestriction}" Foreground="White"
                                                               FontWeight="Bold" FontSize="13"/>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="22" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                    <TextBlock Text="📅" FontSize="15"/>
                                                    <TextBlock Text="{Binding EventDate, StringFormat='{}{0:dd MMMM yyyy, HH:mm}'}"
                                                               Foreground="#A6A6BF" FontSize="14"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                    <TextBlock Text="🏟" FontSize="15"/>
                                                    <TextBlock Text="{Binding HallName}"
                                                               Foreground="#A6A6BF" FontSize="14"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Grid Grid.Row="3" ColumnDefinitions="*, *, Auto" Margin="0,18,0,2">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="ПАРТЕР" FontSize="11" Foreground="#7A7A93"
                                                               FontWeight="Bold" LetterSpacing="1"/>
                                                    <TextBlock Text="{Binding ParterrePrice, StringFormat='{}{0:N0} ₽'}"
                                                               FontSize="21" FontWeight="Bold" Foreground="#2BEE8C"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="VIP + БЕЙДЖ" FontSize="11" Foreground="#7A7A93"
                                                               FontWeight="Bold" LetterSpacing="1"/>
                                                    <TextBlock Text="{Binding VipFinalPrice, StringFormat='{}{0:N0} ₽'}"
                                                               FontSize="21" FontWeight="Bold" Foreground="#FFD700"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="buy" Content="КУПИТЬ БИЛЕТ"
                                                        Background="#FFD700" Foreground="#121212" FontSize="15"
                                                        FontWeight="Bold" Padding="26,14" CornerRadius="12"
                                                        VerticalAlignment="Center"
                                                        Click="BtnBuyTicket_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ──────── ПАНЕЛЬ 2: Мои билеты ──────── -->
            <Grid x:Name="PanelMyTickets" Grid.Row="1" Margin="28,20" RowDefinitions="Auto, *, Auto" IsVisible="False">
                <TextBlock Text="Ваши заказы" FontSize="19" FontWeight="Bold" Foreground="White" Margin="4,0,0,14"/>
                <DataGrid ItemsSource="{Binding MyOrders}" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" Background="#17172A" RowBackground="#17172A"
                          Foreground="#E6E6F0" BorderBrush="#2E2E46"
                          GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер заказа" Binding="{Binding OrderRef}" Width="160"/>
                        <DataGridTextColumn Header="Концерт" Binding="{Binding ArtistName}" Width="*"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding EventDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} ₽'}" Width="120"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                        <DataGridTemplateColumn Header="Действия" Width="310">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:MyOrder">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4">
                                        <Button Classes="green" Content="Оплатить" Background="#2BEE8C" Foreground="#121212"
                                                FontSize="12" FontWeight="SemiBold" Padding="10,6" CornerRadius="6"
                                                Click="BtnPayOrder_Click" Tag="{Binding}" IsEnabled="{Binding CanPay}"/>
                                        <Button Classes="dark" Content="Скачать билет" Background="#22223A" Foreground="#C9C9D9"
                                                FontSize="12" Padding="10,6" CornerRadius="6"
                                                Click="BtnExportOrder_Click" Tag="{Binding}" IsEnabled="{Binding CanExport}"/>
                                        <Button Classes="danger" Content="Отменить" Background="#3A2430" Foreground="#FF6B6B"
                                                FontSize="12" Padding="10,6" CornerRadius="6"
                                                Click="BtnCancelOrder_Click" Tag="{Binding}" IsEnabled="{Binding CanCancel}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="TxtOrdersMessage" Grid.Row="2" Text="" Foreground="#2BEE8C"
                           FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="False"
                           Margin="4,12,4,0"/>
            </Grid>

            <!-- ──────── ПАНЕЛЬ 3: Профиль ──────── -->
            <Border x:Name="PanelProfile" Grid.Row="1" Margin="28,20" Background="#17172A"
                    CornerRadius="18" Padding="36" IsVisible="False" VerticalAlignment="Top"
                    HorizontalAlignment="Left" BorderBrush="#2E2E46" BorderThickness="1"
                    BoxShadow="0 12 32 0 #55000000">
                <StackPanel Spacing="16" MaxWidth="480">
                    <TextBlock Text="Мой профиль" FontSize="22" FontWeight="Bold" Foreground="#FFD700"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="ФИО" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                        <TextBox x:Name="TxtProfileName" FontSize="14" Background="#22223A"
                                 Foreground="White" BorderBrush="#2E2E46" Height="42" CornerRadius="10"
                                 Padding="12,10" TextChanged="TxtProfileName_TextChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="EMAIL" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                        <TextBox x:Name="TxtProfileEmail" FontSize="14" Background="#22223A"
                                 Foreground="White" BorderBrush="#2E2E46" Height="42" CornerRadius="10" Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="ТЕЛЕФОН" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                        <TextBox x:Name="TxtProfilePhone" MaxLength="18" FontSize="14" Background="#22223A"
                                 PlaceholderText="+7 (999) 123-45-67"
                                 Foreground="White" BorderBrush="#2E2E46" Height="42" CornerRadius="10"
                                 Padding="12,10" TextChanged="TxtProfilePhone_TextChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="ПОДПИСКА НА ПРОМОКОДЫ" FontSize="11" FontWeight="Bold"
                                   Foreground="#8F8FA6" LetterSpacing="1"/>
                        <TextBlock x:Name="TxtProfilePromo" FontSize="15" FontWeight="Bold" Foreground="#2BEE8C"/>
                    </StackPanel>

                    <Button Classes="gold" Content="СОХРАНИТЬ ИЗМЕНЕНИЯ" Background="#FFD700" Foreground="#121212"
                            FontWeight="Bold" Height="46" CornerRadius="10" Click="BtnSaveProfile_Click"
                            Margin="0,8,0,0"/>
                    <TextBlock x:Name="TxtProfileMessage" Foreground="#2BEE8C" IsVisible="False"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
