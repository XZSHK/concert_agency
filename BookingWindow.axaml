<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Avalon"
        x:Class="Avalon.BookingWindow"
        x:DataType="local:ConcertEvent"
        Title="Бронирование билетов — Арт-Престиж"
        WindowStartupLocation="CenterScreen"
        Width="760" Height="860"
        CanResize="True"
        Background="#0F0F18"
        FontFamily="Inter, Segoe UI, Arial">

    <Window.Styles>
        <Style Selector="Button.buy:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFE255" />
        </Style>
        <Style Selector="Button.qty:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E2E46" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *" Margin="18">

        <!-- ═══════ Герой-баннер с картинкой из img/ (колесико мыши / кнопки — масштаб) ═══════ -->
        <Border x:Name="HeroBorder" CornerRadius="18" ClipToBounds="True" MinHeight="230"
                BorderBrush="#2E2E46" BorderThickness="1" Background="#0F0F18"
                PointerWheelChanged="HeroImage_PointerWheelChanged">
            <Grid RowDefinitions="230, Auto">
                <Image Grid.Row="0" x:Name="HeroImage" Source="{Binding ImageSource}" Stretch="Uniform"
                       RenderTransformOrigin="50%,50%" PointerWheelChanged="HeroImage_PointerWheelChanged">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Кнопки масштаба -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Orientation="Horizontal" Spacing="6" Margin="10">
                    <Button Classes="ghost" Content="−" Width="34" Height="34" FontSize="18" Background="#CC17172A"
                            Foreground="White" CornerRadius="8" Click="BtnHeroZoomOut_Click"/>
                    <Button x:Name="TxtHeroZoom" Classes="ghost" Content="100%" MinWidth="48" Height="34" Background="#CC17172A"
                            Foreground="#FFD700" FontSize="12" FontWeight="Bold" CornerRadius="8"
                            Click="BtnHeroZoomReset_Click" ToolTip.Tip="Сбросить масштаб"/>
                    <Button Classes="ghost" Content="+" Width="34" Height="34" FontSize="18" Background="#CC17172A"
                            Foreground="White" CornerRadius="8" Click="BtnHeroZoomIn_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,8"
                           Text="🔍 Колесико мыши или кнопки — масштаб афиши" FontSize="10"
                           Foreground="#A6A6BF" IsHitTestVisible="False"/>

                <Border Grid.Row="1" Background="#E617172A" Padding="26,16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TxtConcertName" FontSize="24" FontWeight="Black" Foreground="#FFD700"/>
                        <TextBlock x:Name="TxtConcertInfo" FontSize="14" Foreground="#A6A6BF"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════ Тело ═══════ -->
        <Border Grid.Row="1" Margin="0,16,0,0" Background="#17172A" CornerRadius="18"
                Padding="26" BorderBrush="#2E2E46" BorderThickness="1"
                BoxShadow="0 14 36 0 #66000000">
            <ScrollViewer>
                <StackPanel Spacing="18">

                    <!-- Партер -->
                    <Border Background="#1F1F36" CornerRadius="14" Padding="20" BorderBrush="#2E2E46" BorderThickness="1">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Партер" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="TxtParterrePrice" Text="0 ₽ / шт" FontSize="13" Foreground="#2BEE8C"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Button Classes="qty" Content="−" Width="42" Height="42" FontSize="19"
                                        Background="#22223A" Foreground="White" CornerRadius="9"
                                        Click="BtnMinusParterre_Click"/>
                                <TextBox x:Name="TxtParterreQty" Text="0" Width="58" Height="42"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         IsReadOnly="True" Background="#0F0F18" Foreground="White"
                                         BorderThickness="0" FontSize="17" CornerRadius="9" FontWeight="Bold"/>
                                <Button Classes="qty" Content="+" Width="42" Height="42" FontSize="19"
                                        Background="#22223A" Foreground="White" CornerRadius="9"
                                        Click="BtnPlusParterre_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- VIP -->
                    <Border Background="#241F30" CornerRadius="14" Padding="20" BorderBrush="#3A3320" BorderThickness="1">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="VIP + бейдж" FontSize="17" FontWeight="Bold" Foreground="#FFD700"/>
                                <TextBlock x:Name="TxtVipPrice" Text="0 ₽ / шт" FontSize="13" Foreground="#FFD700"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Button Classes="qty" Content="−" Width="42" Height="42" FontSize="19"
                                        Background="#2A2438" Foreground="White" CornerRadius="9"
                                        Click="BtnMinusVip_Click"/>
                                <TextBox x:Name="TxtVipQty" Text="0" Width="58" Height="42"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         IsReadOnly="True" Background="#0F0F18" Foreground="White"
                                         BorderThickness="0" FontSize="17" CornerRadius="9" FontWeight="Bold"/>
                                <Button Classes="qty" Content="+" Width="42" Height="42" FontSize="19"
                                        Background="#2A2438" Foreground="White" CornerRadius="9"
                                        Click="BtnPlusVip_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Итоги -->
                    <Border Background="#0F0F18" CornerRadius="14" Padding="22"
                            BorderBrush="#2E2E46" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Стоимость билетов" Foreground="#8F8FA6" FontSize="14"/>
                                <TextBlock x:Name="TxtBasePrice" Grid.Column="1" Text="0 ₽"
                                           FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Сервисный сбор (10%)" Foreground="#8F8FA6" FontSize="14"/>
                                <TextBlock x:Name="TxtServiceFee" Grid.Column="1" Text="0 ₽"
                                           FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                            </Grid>
                            <Separator Background="#2E2E46" Margin="0,4"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="ИТОГО" FontSize="17" FontWeight="Bold" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTotal" Grid.Column="1" Text="0 ₽" FontSize="24"
                                           FontWeight="Black" Foreground="#FFD700"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Статус брони (ТЗ: DispatcherTimer 15 мин) -->
                    <Border Background="#0F0F18" CornerRadius="14" Padding="22"
                            BorderBrush="#2E2E46" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Статус заказа" Foreground="#8F8FA6" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBookingStatus" Grid.Column="1" Text="Не оформлен"
                                           FontWeight="SemiBold" Foreground="White" FontSize="14"
                                           TextAlignment="Right"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Таймер брони (15 мин)" Foreground="#8F8FA6" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTimer" Grid.Column="1" Text="--:--"
                                           FontWeight="Black" Foreground="#FFD700" FontSize="20"/>
                            </Grid>
                            <TextBlock x:Name="TxtBookingMessage" Text="" Foreground="#2BEE8C"
                                       FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Content="Отмена" Background="#22223A" Foreground="#C9C9D9"
                                Padding="18,12" CornerRadius="10" Click="BtnCancel_Click" FontSize="14"/>
                        <Button x:Name="BtnConfirm" Classes="buy" Content="ОФОРМИТЬ"
                                Background="#FFD700" Foreground="#121212" FontWeight="Bold"
                                Padding="18,12" CornerRadius="10" Click="BtnConfirm_Click" FontSize="14"/>
                        <Button x:Name="BtnPay" Classes="green" Content="ОПЛАТИТЬ"
                                Background="#2BEE8C" Foreground="#121212" FontWeight="Bold"
                                Padding="18,12" CornerRadius="10" Click="BtnPay_Click"
                                FontSize="14" IsEnabled="False"/>
                        <Button x:Name="BtnExportTicket" Content="СКАЧАТЬ БИЛЕТ"
                                Background="#22223A" Foreground="White"
                                Padding="18,12" CornerRadius="10" Click="BtnExportTicket_Click"
                                FontSize="14" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
