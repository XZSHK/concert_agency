<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Avalon.ConfirmDialog"
        Title="Подтверждение"
        WindowStartupLocation="CenterOwner"
        Width="440" Height="220"
        CanResize="False"
        Background="#0F0F18"
        FontFamily="Inter, Segoe UI, Arial">

    <StackPanel Margin="24,20" Spacing="14">
        <TextBlock x:Name="TxtQuestion" Text="Удалить выбранную позицию?" FontSize="15"
                   Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="Это действие нельзя отменить. Итоги документа будут пересчитаны."
                   FontSize="12" Foreground="#8F8FA6" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Classes="dark" Content="Отмена" Background="#22223A" Foreground="#C9C9D9"
                    Padding="18,10" CornerRadius="8" Click="BtnNo_Click"/>
            <Button x:Name="BtnYes" Content="Удалить" Background="#3A2430" Foreground="#FF6B6B"
                    FontWeight="SemiBold" Classes="danger" Padding="18,10" CornerRadius="8"
                    Click="BtnYes_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
