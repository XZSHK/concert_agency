<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Avalon"
        x:Class="Avalon.ProducerDashboardWindow"
        x:DataType="local:ProducerDashboardWindow"
        Title="Арт-Престиж — Продюсер гастролей"
        WindowStartupLocation="CenterScreen" Width="1200" Height="800" WindowState="Maximized"
        Background="#0F0F18"
        FontFamily="Inter, Segoe UI, Arial">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9C9D9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22223A" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFE255" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border, ComboBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#FFD700" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="280, *">

        <!-- ══════════ Боковая панель ══════════ -->
        <Border Background="#15152A" Padding="22,26" BorderBrush="#22223A" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="АРТ-ПРЕСТИЖ" FontSize="23" FontWeight="Black"
                               Foreground="#FFD700" LetterSpacing="3"/>
                    <TextBlock Text="Кабинет продюсера гастролей" FontSize="11" Foreground="#7A7A93"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="6" Margin="0,38,0,0">
                    <Button Classes="nav" Content="🏟  Площадки" Click="ShowHalls_Click"/>
                    <Button Classes="nav" Content="🎤  Создать концерт" Click="ShowCreateEvent_Click"/>
                    <Button Classes="nav" Content="🎶  Концерты и афиши" Click="ShowConcerts_Click"/>
                    <Button Classes="nav" Content="💰  Гонорары" Click="ShowFees_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="12">
                    <Separator Background="#22223A"/>
                    <TextBlock x:Name="TxtUserName" Foreground="#E6E6F0" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <Button Classes="outline" Content="Выйти из аккаунта" HorizontalAlignment="Stretch"
                            Background="Transparent" BorderBrush="#3A3A55" BorderThickness="1"
                            Foreground="#FF6B6B" Padding="14,11" CornerRadius="10"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ Контент ══════════ -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <Border Background="#15152A" Padding="32,16" BorderBrush="#22223A" BorderThickness="0,0,0,1">
                <TextBlock Text="Управление гастролями" FontSize="23" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </Border>

            <!-- ──────── Панель: Площадки ──────── -->
            <Grid x:Name="PanelHalls" Grid.Row="1" Margin="28,20" RowDefinitions="Auto, *">
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="4,0,4,14">
                    <TextBlock Text="Доступные концертные залы" FontSize="19" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button Classes="dark" Content="Обновить" Background="#22223A" Foreground="#C9C9D9"
                            Padding="16,8" CornerRadius="8" Click="BtnRefreshHalls_Click"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Halls}" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" Background="#17172A" RowBackground="#17172A"
                          Foreground="#E6E6F0" BorderBrush="#2E2E46"
                          GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Название зала" Binding="{Binding HallName}" Width="*"/>
                        <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="160"/>
                        <DataGridTextColumn Header="Партер" Binding="{Binding ParterreCapacity}" Width="100"/>
                        <DataGridTextColumn Header="VIP" Binding="{Binding VipCapacity}" Width="100"/>
                        <DataGridTextColumn Header="Аренда (₽/день)" Binding="{Binding RentPerDay, StringFormat='{}{0:N0}'}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ──────── Панель: Концерты (редактирование) ──────── -->
            <Grid x:Name="PanelConcerts" Grid.Row="1" Margin="28,20" RowDefinitions="Auto, *" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="4,0,4,14">
                    <TextBlock Text="Концерты и афиши" FontSize="19" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button Classes="dark" Content="Обновить" Background="#22223A" Foreground="#C9C9D9"
                            Padding="16,8" CornerRadius="8" Click="BtnRefreshConcerts_Click"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Concerts}" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" Background="#17172A" RowBackground="#17172A"
                          Foreground="#E6E6F0" BorderBrush="#2E2E46"
                          GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Исполнитель" Binding="{Binding ArtistName}" Width="*"/>
                        <DataGridTextColumn Header="Зал" Binding="{Binding HallName}" Width="200"/>
                        <DataGridTextColumn Header="Дата и время" Binding="{Binding EventDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="160"/>
                        <DataGridTextColumn Header="Партер" Binding="{Binding ParterrePrice, StringFormat='{}{0:N0} ₽'}" Width="110"/>
                        <DataGridTextColumn Header="VIP" Binding="{Binding VipPrice, StringFormat='{}{0:N0} ₽'}" Width="110"/>
                        <DataGridTextColumn Header="Афиша" Binding="{Binding ImageName}" Width="160"/>
                        <DataGridTemplateColumn Header="Действия" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:ProducerEventData">
                                    <Button Classes="gold" Content="Редактировать" Background="#FFD700" Foreground="#121212"
                                            FontSize="12" FontWeight="SemiBold" Padding="12,7" CornerRadius="6"
                                            Margin="0,4" Click="BtnEditEvent_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ──────── Панель: Создать концерт ──────── -->
            <ScrollViewer x:Name="PanelCreateEvent" Grid.Row="1" IsVisible="False" Margin="28,20">
                <Border Background="#17172A" CornerRadius="18" Padding="32"
                        BorderBrush="#2E2E46" BorderThickness="1"
                        HorizontalAlignment="Left" BoxShadow="0 12 32 0 #55000000">
                    <StackPanel Spacing="16" MaxWidth="620">
                        <TextBlock x:Name="TxtFormTitle" Text="Новый концерт" FontSize="22" FontWeight="Bold" Foreground="#FFD700"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="НАЗВАНИЕ ГРУППЫ" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                            <TextBox x:Name="TxtArtistName" PlaceholderText="Например: ВИА «Самоцветы»"
                                     Height="42" CornerRadius="10" Background="#22223A"
                                     Foreground="White" BorderBrush="#2E2E46" FontSize="14" Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="ЗАЛ" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                            <ComboBox x:Name="CmbHalls" ItemsSource="{Binding Halls}"
                                      HorizontalAlignment="Stretch" PlaceholderText="Выберите зал…"
                                      Height="42" CornerRadius="10" Background="#22223A"
                                      Foreground="White" BorderBrush="#2E2E46" FontSize="14" Padding="10,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:HallData">
                                        <TextBlock Text="{Binding HallName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Дата концерта (маска дд.мм.гггг чч:мм) -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="ДАТА И ВРЕМЯ КОНЦЕРТА" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                            <TextBox x:Name="TxtEventDate" PlaceholderText="31.12.2026 20:00" MaxLength="16"
                                     Height="42" CornerRadius="10" Background="#22223A"
                                     Foreground="White" BorderBrush="#2E2E46" FontSize="14"
                                     Padding="12,10" TextChanged="TxtEventDate_TextChanged"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Spacing="6" Margin="0,0,8,0">
                                <TextBlock Text="ЦЕНА ПАРТЕРА (₽)" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                                <TextBox x:Name="TxtParterrePrice" PlaceholderText="1500.00"
                                         Height="42" CornerRadius="10" Background="#22223A"
                                         Foreground="White" BorderBrush="#2E2E46" FontSize="14"
                                         Padding="12,10" TextChanged="TxtParterrePrice_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                <TextBlock Text="ЦЕНА VIP (БЕЗ БЕЙДЖА, ₽)" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                                <TextBox x:Name="TxtVipPrice" PlaceholderText="3000.00"
                                         Height="42" CornerRadius="10" Background="#22223A"
                                         Foreground="White" BorderBrush="#2E2E46" FontSize="14"
                                         Padding="12,10" TextChanged="TxtVipPrice_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Spacing="6" Margin="0,0,8,0">
                                <TextBlock Text="ВОЗРАСТНОЕ ОГРАНИЧЕНИЕ" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                                <TextBox x:Name="TxtAgeRestriction" PlaceholderText="12+" MaxLength="3"
                                         Height="42" CornerRadius="10" Background="#22223A"
                                         Foreground="White" BorderBrush="#2E2E46" FontSize="14"
                                         Padding="12,10" TextChanged="TxtAgeRestriction_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                <TextBlock Text="ФАЙЛ АФИШИ ИЗ img/" FontSize="11" FontWeight="Bold" Foreground="#8F8FA6" LetterSpacing="1"/>
                                <TextBox x:Name="TxtImagePath" PlaceholderText="kino.jpg"
                                         Height="42" CornerRadius="10" Background="#22223A"
                                         Foreground="White" BorderBrush="#2E2E46" FontSize="14"
                                         Padding="12,10" TextChanged="TxtImagePath_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Зона предпросмотра афиши: принимает перетаскивание файла -->
                        <Border x:Name="ImgDropZone" Height="170" CornerRadius="12" ClipToBounds="True"
                                BorderBrush="#3A3A5A" BorderThickness="2" Background="#22223A"
                                DragDrop.AllowDrop="True" DragDrop.Drop="ImgDropZone_Drop"
                                DragDrop.DragOver="ImgDropZone_DragOver">
                            <Grid>
                                <Image x:Name="ImgPreview" Stretch="Uniform"
                                       RenderTransformOrigin="50%,50%">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Image.RenderTransform>
                                </Image>
                                <StackPanel x:Name="ImgDropHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="🖼" FontSize="40" HorizontalAlignment="Center" Opacity="0.65"/>
                                    <TextBlock Text="Перетащите сюда картинку" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#C9C9D9" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="PNG, JPG или WEBP" FontSize="9"
                                               Foreground="#7A7A93" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Масштаб и размер кадра афиши -->
                        <Border Background="#1F1F36" CornerRadius="10" Padding="12,10"
                                BorderBrush="#2E2E46" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ОТДАЛЕНИЕ И КАДР АФИШИ" FontSize="11" FontWeight="Bold"
                                           Foreground="#8F8FA6" LetterSpacing="1"/>
                                <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <TextBlock Text="Отдаление (масштаб)" FontSize="11" Foreground="#C9C9D9"/>
                                            <TextBlock x:Name="TxtImageZoomValue" Grid.Column="1" Text="100%"
                                                       FontSize="11" FontWeight="Bold" Foreground="#FFD700"/>
                                        </Grid>
                                        <Slider x:Name="SldImageZoom" Minimum="0.25" Maximum="2.0" Value="1.0"
                                                ValueChanged="SldImageZoom_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <TextBlock Text="Размер кадра (высота)" FontSize="11" Foreground="#C9C9D9"/>
                                            <TextBlock x:Name="TxtFrameHeightValue" Grid.Column="1" Text="170 px"
                                                       FontSize="11" FontWeight="Bold" Foreground="#FFD700"/>
                                        </Grid>
                                        <Slider x:Name="SldFrameHeight" Minimum="110" Maximum="360" Value="170"
                                                ValueChanged="SldFrameHeight_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Режим кадра" FontSize="11" Foreground="#C9C9D9"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button x:Name="BtnFitUniform" Classes="dark" Content="Вписать" Padding="12,7" FontSize="11"
                                                    CornerRadius="6" Background="#FFD700" Foreground="#121212"
                                                    FontWeight="SemiBold" Click="BtnFitUniform_Click"/>
                                            <Button x:Name="BtnFillCrop" Classes="dark" Content="Заполнить" Padding="12,7" FontSize="11"
                                                    CornerRadius="6" Background="#22223A" Foreground="#C9C9D9"
                                                    FontWeight="SemiBold" Click="BtnFillCrop_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Перетащите файл изображения в рамку — он скопируется в папку img/ и сохранится в БД. Или впишите имя файла из img/ вручную."
                                   FontSize="11" Foreground="#7A7A93" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="accent" x:Name="BtnCreateEvent" Content="СОЗДАТЬ КОНЦЕРТ" Height="46" CornerRadius="10"
                                    Background="#FFD700" Foreground="#121212" FontWeight="Bold"
                                    FontSize="15" Click="BtnCreateEvent_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    MinWidth="280"/>
                            <Button x:Name="BtnCancelEdit" Classes="dark" Content="✕  Отменить редактирование" Height="46"
                                    CornerRadius="10" Background="#22223A" Foreground="#C9C9D9"
                                    FontWeight="SemiBold" FontSize="14" Click="BtnCancelEdit_Click"
                                    IsVisible="False"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtMessage" Foreground="#FF5A5A" IsVisible="False"
                                   TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ──────── Панель: Гонорары ──────── -->
            <Grid x:Name="PanelFees" Grid.Row="1" Margin="28,20" RowDefinitions="Auto, *" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="4,0,4,14">
                    <TextBlock Text="Расчёт гонораров исполнителей" FontSize="19" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button Classes="dark" Content="Обновить" Background="#22223A" Foreground="#C9C9D9"
                            Padding="16,8" CornerRadius="8" Click="BtnRefreshFees_Click"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Fees}" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" Background="#17172A" RowBackground="#17172A"
                          Foreground="#E6E6F0" BorderBrush="#2E2E46"
                          GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Исполнитель" Binding="{Binding ArtistName}" Width="*"/>
                        <DataGridTextColumn Header="Зал" Binding="{Binding HallName}" Width="220"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding EventDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="130"/>
                        <DataGridTextColumn Header="Потенциал сбора" Binding="{Binding TotalPotential, StringFormat='{}{0:N0} ₽'}" Width="170"/>
                        <DataGridTextColumn Header="Гонорар (30%)" Binding="{Binding Fee, StringFormat='{}{0:N0} ₽'}" Width="170"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
