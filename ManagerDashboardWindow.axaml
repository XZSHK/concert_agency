<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Avalon"
        x:Class="Avalon.ManagerDashboardWindow"
        x:DataType="local:ManagerDashboardWindow"
        Title="Арт-Престиж — Менеджер билетной программы"
        WindowStartupLocation="CenterScreen" Width="1200" Height="800" WindowState="Maximized"
        Background="#0F0F18"
        FontFamily="Inter, Segoe UI, Arial">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9C9D9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22223A" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#FFD700" />
        </Style>
        <!-- Цветовая индикация критических состояний документа -->
        <Style Selector="DataGridRow.order-critical">
            <Setter Property="Background" Value="#2E2410" />
        </Style>
        <Style Selector="DataGridRow.order-refund">
            <Setter Property="Background" Value="#2A1218" />
        </Style>
        <Style Selector="DataGridRow.order-done">
            <Setter Property="Background" Value="#101F17" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="280, *">

        <!-- ══════════ Боковая панель ══════════ -->
        <Border Background="#15152A" Padding="22,26" BorderBrush="#22223A" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="АРТ-ПРЕСТИЖ" FontSize="23" FontWeight="Black"
                               Foreground="#FFD700" LetterSpacing="3"/>
                    <TextBlock Text="Кабинет менеджера билетной программы" FontSize="11"
                               Foreground="#7A7A93" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="6" Margin="0,38,0,0">
                    <Button Classes="nav" Content="🎟  Заказы"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="12">
                    <Separator Background="#22223A"/>
                    <TextBlock x:Name="TxtUserName" Foreground="#E6E6F0" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <Button Classes="outline" Content="Выйти из аккаунта" HorizontalAlignment="Stretch"
                            Background="Transparent" BorderBrush="#3A3A55" BorderThickness="1"
                            Foreground="#FF6B6B" Padding="14,11" CornerRadius="10"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ Контент ══════════ -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <Border Background="#15152A" Padding="32,16" BorderBrush="#22223A" BorderThickness="0,0,0,1">
                <TextBlock Text="Управление заказами" FontSize="23" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </Border>

            <Grid Grid.Row="1" Margin="28,20" RowDefinitions="Auto, *, Auto">

                <!-- Панель инструментов: заголовок, поиск, фильтры, обновить -->
                <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto" Margin="4,0,4,14">
                    <TextBlock Text="Все заказы" FontSize="19" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>

                    <!-- Поиск по номеру/покупателю/концерту -->
                    <TextBox Grid.Column="1" x:Name="TxtSearch" Width="250" Height="38"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             PlaceholderText="Поиск: номер, покупатель, концерт…"
                             Background="#22223A" Foreground="White" BorderBrush="#2E2E46"
                             CornerRadius="9" Padding="10,8" FontSize="13" Margin="0,0,10,0"
                             TextChanged="TxtSearch_TextChanged"/>

                    <!-- Фильтр по статусам -->
                    <ComboBox Grid.Column="2" x:Name="CmbStatusFilter" Width="190" Height="38"
                              VerticalAlignment="Center" Background="#22223A" Foreground="White"
                              FontSize="13" Margin="0,0,10,0"
                              SelectionChanged="CmbStatusFilter_SelectionChanged"/>

                    <!-- Фильтр по дате концерта: дд.мм.гггг (маска) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="8" Margin="0,0,12,0">
                        <TextBlock Text="Дата концерта:" Foreground="#8F8FA6" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtFilterDate" PlaceholderText="дд.мм.гггг" MaxLength="10"
                                 Width="130" Height="36" CornerRadius="9" Background="#22223A"
                                 Foreground="White" BorderBrush="#2E2E46" FontSize="13"
                                 Padding="10,8" VerticalContentAlignment="Center"
                                 TextChanged="TxtFilterDate_TextChanged"/>
                        <Button Classes="dark" Content="✕" Background="#22223A" Foreground="#C9C9D9"
                                Width="36" Height="36" CornerRadius="9" FontSize="14"
                                Click="BtnClearFilter_Click" ToolTip.Tip="Сбросить фильтр"/>
                    </StackPanel>

                    <Button Grid.Column="4" Classes="dark" Content="Обновить" Background="#22223A" Foreground="#C9C9D9"
                            Padding="16,9" CornerRadius="8" Click="BtnRefresh_Click"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Таблица заказов: действия по FSM включаются по статусу -->
                <DataGrid x:Name="GridOrders" Grid.Row="1" AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          IsReadOnly="True" Background="#17172A" RowBackground="#17172A"
                          Foreground="#E6E6F0" BorderBrush="#2E2E46"
                          GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding OrderRef}" Width="150"/>
                        <DataGridTextColumn Header="Покупатель" Binding="{Binding BuyerName}" Width="*"/>
                        <DataGridTextColumn Header="Концерт" Binding="{Binding ArtistName}" Width="*"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding EventDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} ₽'}" Width="120"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140"/>
                        <DataGridTemplateColumn Header="Действия (FSM)" Width="490">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:OrderData">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4">
                                        <Button Classes="green" Content="Оплачен" Background="#2BEE8C" Foreground="#121212"
                                                FontSize="11" FontWeight="SemiBold" Padding="10,6" CornerRadius="6"
                                                Click="BtnPay_Click" Tag="{Binding}" IsEnabled="{Binding CanPay}"/>
                                        <Button Classes="gold" Content="Выписать" Background="#FFD700" Foreground="#121212"
                                                FontSize="11" FontWeight="SemiBold" Padding="10,6" CornerRadius="6"
                                                Click="BtnIssue_Click" Tag="{Binding}" IsEnabled="{Binding CanIssue}"/>
                                        <Button Classes="blue" Content="Контроль на входе" Background="#2B3A55" Foreground="#9EC1FF"
                                                FontSize="11" Padding="10,6" CornerRadius="6"
                                                Click="BtnEntryControl_Click" Tag="{Binding}" IsEnabled="{Binding CanControl}"/>
                                        <Button Classes="danger" Content="Возврат" Background="#3A2430" Foreground="#FF6B6B"
                                                FontSize="11" Padding="10,6" CornerRadius="6"
                                                Click="BtnRefund_Click" Tag="{Binding}" IsEnabled="{Binding CanRefund}"/>
                                        <Button Classes="blue" Content="Документ" Background="#2B3A55" Foreground="#9EC1FF"
                                                FontSize="11" Padding="10,6" CornerRadius="6"
                                                Click="BtnViewDocument_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtMessage" Grid.Row="2" Text="" Foreground="#2BEE8C"
                           FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="False"
                           Margin="4,12,4,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
