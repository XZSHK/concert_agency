<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Avalon"
        x:Class="Avalon.ManagerDashboardWindow"
        x:DataType="local:ManagerDashboardWindow"
        Title="Панель Менеджера"
        WindowStartupLocation="CenterScreen" Width="1200" Height="800" WindowState="Maximized"
        Background="#121212">
    
    <Grid ColumnDefinitions="260, *">
        <Border Background="#1E1E2F" Padding="20">
            <StackPanel Spacing="30">
                <TextBlock Text="АПР-ПРЕСТИЖ" FontSize="22" FontWeight="Black" Foreground="#FFD700" LetterSpacing="1"/>
                <StackPanel Spacing="8">
                    <Button Content="🎟 Заказы" Background="Transparent" Foreground="#E0E0E0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,12" CornerRadius="8" FontSize="15"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <Border Background="#1E1E2F" Padding="30,15" BoxShadow="0 4 10 0 #50000000">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Управление заказами" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                        <TextBlock x:Name="TxtUserName" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Button Content="Выйти" Background="Transparent" Foreground="#FF5555" BorderBrush="#FF5555" BorderThickness="1" Padding="15,8" CornerRadius="5" Click="BtnLogout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30" RowDefinitions="Auto, *">
                <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,15">
                    <TextBlock Text="Все заказы" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Button Content="Обновить" Background="#FFD700" Foreground="#121212" Padding="10,5" CornerRadius="5" Click="BtnRefresh_Click"/>
                </StackPanel>
                
                <DataGrid ItemsSource="{Binding Orders}" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="#1E1E2F" RowBackground="#1E1E2F" Foreground="#E0E0E0" BorderBrush="#333355">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Заказ" Binding="{Binding OrderRef}" Width="120"/>
                        <DataGridTextColumn Header="Покупатель" Binding="{Binding BuyerName}" Width="*"/>
                        <DataGridTextColumn Header="Концерт" Binding="{Binding ArtistName}" Width="*"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat='{}{0:C0}'}" Width="120"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                        <DataGridTemplateColumn Header="Действие" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:OrderData">
                                    <Button Content="Возврат" Background="#FF5555" Foreground="White" FontSize="12"
                                            Click="BtnRefund_Click" Tag="{Binding}" CornerRadius="4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>